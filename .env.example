# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Keys (supports up to 3 keys for rotation)
GEMINI_API_KEY=your-primary-gemini-api-key
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
MOSAIC_AI_PROVIDER=groq
GROQ_API_KEY=your-primary-groq-api-key
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODELS=openai/gpt-oss-20b

# News Providers
GNEWS_API_KEY=your-gnews-api-key
NEWSDATA_API_KEY=your-newsdata-api-key
CURRENTS_API_KEY=your-currents-api-key

# Cron & Maintenance Secret (required in production for /api/maintenance/*)
CRON_SECRET=your-secure-cron-secret

# Gemini Models Configuration
GEMINI_HOMEPAGE_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_ANALYSIS_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-flash-tts,gemini-3.1-flash-tts,gemini-embedding-001,gemini-embedding-002,gemma-4-26b,gemma-4-31b,gemini-robotics-er-2-preview
